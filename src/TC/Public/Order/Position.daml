-- Partners can read their positions without the Tradecraft core package.
-- The venue and vault control replacement; the owner cannot change the state.

module TC.Public.Order.Position
  ( Position(..)
  , PositionKey(..)
  , Position_Replace(..)
  , isSpent
  ) where

import DA.Numeric (RoundingMode (..), castAndRound, roundNumeric)

import Splice.Api.Token.HoldingV1 (InstrumentId)
import TC.Public.Order.Types (TickRange (..), isValidRange)

-- | Complete identity of one live position. The protocol expects at most
-- one live position per key.
data PositionKey = PositionKey
  with
    venue : Party
    vault : Party
    ammId : Text
    owner : Party
    lower : Int
    upper : Int
  deriving (Eq, Ord, Show)

template Position
  with
    venue : Party
    vault : Party
    ammId : Text
    owner : Party
    instrument1 : InstrumentId
    instrument2 : InstrumentId
    range : TickRange
    liquidity : Decimal
    feeGrowthInside1Last : Numeric 20
    feeGrowthInside2Last : Numeric 20
    tokensOwed1 : Numeric 20
    tokensOwed2 : Numeric 20
  where
    signatory vault
    observer venue, owner

    key
      PositionKey
        with venue, vault, ammId, owner, lower = range.lower, upper = range.upper
      : PositionKey
    maintainer key.vault

    ensure
      isValidRange range
      && liquidity >= 0.0
      && tokensOwed1 >= 0.0
      && tokensOwed2 >= 0.0
      && not (isSpent liquidity tokensOwed1 tokensOwed2)

    -- | Replace the state without changing the position identity.
    -- A final zero state consumes the position without a successor.
    choice Position_Replace : Optional (ContractId Position)
      with
        liquidity : Decimal
        feeGrowthInside1Last : Numeric 20
        feeGrowthInside2Last : Numeric 20
        tokensOwed1 : Numeric 20
        tokensOwed2 : Numeric 20
      controller venue, vault
      do
        require "Replaced position amounts must be nonnegative" $
          liquidity >= 0.0 && tokensOwed1 >= 0.0 && tokensOwed2 >= 0.0
        if isSpent liquidity tokensOwed1 tokensOwed2
          then pure None
          else Some <$> create this with
            liquidity
            feeGrowthInside1Last
            feeGrowthInside2Last
            tokensOwed1
            tokensOwed2

-- | A position is spent when it holds no liquidity and each owed amount
-- rounds down to zero at the payment scale. Owed amounts keep full
-- Numeric 20 precision; fractions below one payment unit stay claimable
-- until later accrual.
isSpent : Decimal -> Numeric 20 -> Numeric 20 -> Bool
isSpent liquidity owed1 owed2 =
  liquidity == 0.0 && downToPayment owed1 == 0.0 && downToPayment owed2 == 0.0

-- | Round a Numeric 20 amount down to the 10-decimal payment scale.
downToPayment : Numeric 20 -> Decimal
downToPayment = castAndRound . roundNumeric 10 RoundingDown

require : Text -> Bool -> Update ()
require msg cond = if cond then pure () else fail msg
